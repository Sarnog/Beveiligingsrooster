# Kopieer dit bestand naar .env (naast docker-compose.yml) en pas aan.
# Alles is optioneel; zonder .env werkt de app ook.

# Adres en poort waarop de app van buiten bereikbaar is
LUISTER_ADRES=0.0.0.0
POORT=8000

# Openbaar adres (nodig voor ICS-links en HTTPS-cookies), bijv. https://rooster.voorbeeld.nl
BASE_URL=

# 1 als er een reverse proxy (Caddy) of tunnel (Cloudflare/Tailscale) voor de app staat
PROXY_VERTROUWEN=0

# Hoe lang je ingelogd blijft (uren)
SESSIE_UREN=12

# Leeg laten: de app maakt zelf een geheime sleutel aan in ./data/secret_key
SECRET_KEY=
