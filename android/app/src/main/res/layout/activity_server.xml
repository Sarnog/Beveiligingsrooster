<?xml version="1.0" encoding="utf-8"?>
<!-- Serverscherm: het adres van de eigen server invullen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wortel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/thema">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/achtergrond"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/server_titel"
                android:textColor="@color/thema"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/server_uitleg"
                android:textColor="@color/tekst"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/adres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:autofillHints="url"
                android:hint="@string/server_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:singleLine="true"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/server_voorbeelden"
                android:textColor="@color/tekst_zacht"
                android:textSize="13sp" />

            <!-- Waarschuwing bij http:// -->
            <TextView
                android:id="@+id/http_waarschuwing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/server_http_waarschuwing"
                android:textColor="@color/tekst_zacht"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Foutmelding na het controleren -->
            <TextView
                android:id="@+id/melding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/fout"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/knop_verbinden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/thema"
                android:text="@string/server_verbinden"
                android:textColor="@color/wit" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
